PORT=3000
CORS_ORIGIN=http://localhost:5173

# Alternativa recomendada: uma URL completa
DATABASE_URL=postgres://usuario:senha@localhost:5432/seu_banco

# Ou use as variaveis PGHOST, PGPORT, PGDATABASE, PGUSER e PGPASSWORD.

# Conta usada temporariamente enquanto a autenticacao ainda nao existe.
CONTA_ID=00000000-0000-0000-0000-000000000001

# Pluggy: crie uma aplicação no Dashboard do Pluggy.
# Nunca exponha o client secret no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional; use https://api.pluggy.ai por padrão.
PLUGGY_BASE_URL=
